+! ---------------------------------------------------------------------------
+SUBROUTINE open_budgets(filename)
+! One column per bud_aer_mas slot, including slot 0. Slot 0 is emitted even
+! though upstream never writes it (every write is IF (nmasxxx > 0) guarded), so
+! the column index equals the Fortran budget index with no off-by-one, and a
+! non-zero value there is itself a finding.
+USE ukca_setup_indices, ONLY: nbudaer
+
+IMPLICIT NONE
+CHARACTER(LEN=*), INTENT(IN) :: filename
+INTEGER :: i
+CHARACTER(LEN=1048576) :: hdr
+CHARACTER(LEN=32) :: fld
+
+IF (LEN_TRIM(filename) == 0) RETURN
+OPEN(NEWUNIT=bud_unit, FILE=filename, STATUS='REPLACE', ACTION='WRITE')
+bud_open = .TRUE.
+hdr = 'step,time_s'
+DO i = 0, nbudaer
+  WRITE(fld,'(",bud",I0)') i
+  hdr = TRIM(hdr)//TRIM(fld)
+END DO
+WRITE(bud_unit,'(A)') TRIM(hdr)
+
+END SUBROUTINE open_budgets
+
+! ---------------------------------------------------------------------------
+SUBROUTINE write_budgets(istep, time_s, st)
+USE ukca_setup_indices,   ONLY: nbudaer
+USE glomap_box_state_mod, ONLY: box_state_type
+
+IMPLICIT NONE
+INTEGER,              INTENT(IN) :: istep
+REAL,                 INTENT(IN) :: time_s
+TYPE(box_state_type), INTENT(IN) :: st
+INTEGER :: i
+CHARACTER(LEN=1048576) :: row
+CHARACTER(LEN=32) :: fld
+
+IF (.NOT. bud_open) RETURN
+WRITE(row,'(I0,",",ES24.16)') istep, time_s
+DO i = 0, nbudaer
+  WRITE(fld,'(",",ES24.16)') st%bud_aer_mas(1,i)
+  row = TRIM(row)//TRIM(fld)
+END DO
+WRITE(bud_unit,'(A)') TRIM(row)
+
+END SUBROUTINE write_budgets
+
+! ---------------------------------------------------------------------------
+SUBROUTINE close_budgets()
+IMPLICIT NONE
+IF (bud_open) CLOSE(bud_unit)
+bud_open = .FALSE.
+END SUBROUTINE close_budgets
 
 ! ---------------------------------------------------------------------------
 SUBROUTINE close_output()
