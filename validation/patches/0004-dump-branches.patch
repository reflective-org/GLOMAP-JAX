diff --color -ruN a/src/box/glomap_branch_mod.F90 b/src/box/glomap_branch_mod.F90
--- a/src/box/glomap_branch_mod.F90	1969-12-31 16:00:00
+++ b/src/box/glomap_branch_mod.F90	2026-08-13 19:24:16
@@ -0,0 +1,135 @@
+! *****************************COPYRIGHT*******************************
+! (c) 2026. Validation instrumentation for the GLOMAP-JAX port.
+! New code, BSD 3-Clause (see fortran/LICENCE). Not part of UKCA.
+! *****************************COPYRIGHT*******************************
+!
+! Description:
+!   Branch-agreement dump (validation gate 0).
+!
+!   GLOMAP-mode does not diverge by precision drift. It diverges by flipped
+!   predicates: roughly ten sites compare a computed float against a threshold
+!   and then select a different closed form. A flip there gives an O(1)
+!   difference between two individually correct float64 implementations, and no
+!   trajectory tolerance can attribute it. Dumping the predicates themselves
+!   turns "the answer moved" into "this comparison went the other way".
+!
+!   Two kinds of record are emitted:
+!
+!     * masks   -- the boolean arrays the Fortran actually branches on,
+!                  as 0/1 per box;
+!     * codes   -- small integers naming WHICH closed form ran, where the
+!                  branch is a multi-way select rather than a single test.
+!                  ukca_solvecoagnucl_v is the case that matters: five forms
+!                  chosen on |A|, sign(D) and |B|, one of which is the
+!                  factor-3 defect (UP-1).
+!
+!   Context (step, substep, mode, component) is carried in module state rather
+!   than passed down, because the leaf routines that own the interesting
+!   predicates -- ukca_solvecoagnucl_v above all -- have no access to the
+!   substep counters. Callers set the context; leaves emit under it.
+!
+!   As with glomap_dump_mod, this module deliberately has NO `USE` statements.
+!   It is compiled into src/box but called from src/ukca, and a dependency in
+!   that direction would create a USE cycle with the box modules that already
+!   depend on UKCA. Taking plain integers keeps the graph acyclic, and taking
+!   INTEGER rather than LOGICAL sidesteps the several logical kinds
+!   (logical_32, log_small) the UKCA routines declare their masks with -- call
+!   sites convert with MERGE(1, 0, mask), which is kind-agnostic.
+!
+!   Controlled by branch_file in &box_run; empty means not written.
+!
+MODULE glomap_branch_mod
+
+IMPLICIT NONE
+PRIVATE
+
+INTEGER, SAVE :: br_unit = -1
+LOGICAL, SAVE :: br_open = .FALSE.
+INTEGER, SAVE :: br_step = 0
+INTEGER, SAVE :: br_imts = 0
+INTEGER, SAVE :: br_izts = 0
+INTEGER, SAVE :: br_i1   = 0
+INTEGER, SAVE :: br_i2   = 0
+CHARACTER(LEN=32), SAVE :: br_site = 'none'
+
+PUBLIC :: branch_start, branch_set_step, branch_set_substep, branch_ctx,       &
+          branch_mask, branch_one, branch_finish
+
+CONTAINS
+
+SUBROUTINE branch_start(filename)
+IMPLICIT NONE
+CHARACTER(LEN=*), INTENT(IN) :: filename
+IF (LEN_TRIM(filename) == 0) RETURN
+OPEN(NEWUNIT=br_unit, FILE=filename, STATUS='REPLACE', ACTION='WRITE')
+! OPEN(NEWUNIT=) returns a NEGATIVE unit, so openness is tracked explicitly
+! rather than by the sign of the unit number.
+br_open = .TRUE.
+WRITE(br_unit,'(A)') 'step,imts,izts,site,i1,i2,tag,ibox,value'
+END SUBROUTINE branch_start
+
+SUBROUTINE branch_set_step(istep)
+IMPLICIT NONE
+INTEGER, INTENT(IN) :: istep
+br_step = istep
+END SUBROUTINE branch_set_step
+
+SUBROUTINE branch_set_substep(imts, izts)
+! Called from ukca_aero_step, which is the only place that knows the substep
+! counters. Everything emitted afterwards is attributed to this substep.
+IMPLICIT NONE
+INTEGER, INTENT(IN) :: imts, izts
+br_imts = imts
+br_izts = izts
+END SUBROUTINE branch_set_substep
+
+SUBROUTINE branch_ctx(site, i1, i2)
+! site names the predicate group; i1/i2 are whatever pair of loop indices
+! disambiguates it -- usually (imode, jmode), (jv, imode) or (imode, icp).
+IMPLICIT NONE
+CHARACTER(LEN=*), INTENT(IN) :: site
+INTEGER, INTENT(IN) :: i1, i2
+br_site = site
+br_i1   = i1
+br_i2   = i2
+END SUBROUTINE branch_ctx
+
+SUBROUTINE branch_mask(tag, nv, value)
+! One record per box. Pass MERGE(1, 0, themask) at the call site.
+IMPLICIT NONE
+CHARACTER(LEN=*), INTENT(IN) :: tag
+INTEGER, INTENT(IN) :: nv
+INTEGER, INTENT(IN) :: value(nv)
+INTEGER :: i
+IF (.NOT. br_open) RETURN
+DO i = 1, nv
+  CALL emit(tag, i, value(i))
+END DO
+END SUBROUTINE branch_mask
+
+SUBROUTINE branch_one(tag, ibox, value)
+! Single-box form, for the predicates that live inside a scalar DO jl loop
+! (ukca_remode, ukca_calcnucrate, ukca_binapara).
+IMPLICIT NONE
+CHARACTER(LEN=*), INTENT(IN) :: tag
+INTEGER, INTENT(IN) :: ibox, value
+IF (.NOT. br_open) RETURN
+CALL emit(tag, ibox, value)
+END SUBROUTINE branch_one
+
+SUBROUTINE emit(tag, ibox, value)
+IMPLICIT NONE
+CHARACTER(LEN=*), INTENT(IN) :: tag
+INTEGER, INTENT(IN) :: ibox, value
+WRITE(br_unit,'(I0,",",I0,",",I0,",",A,",",I0,",",I0,",",A,",",I0,",",I0)')    &
+  br_step, br_imts, br_izts, TRIM(br_site), br_i1, br_i2, TRIM(tag),           &
+  ibox, value
+END SUBROUTINE emit
+
+SUBROUTINE branch_finish()
+IMPLICIT NONE
+IF (br_open) CLOSE(br_unit)
+br_open = .FALSE.
+END SUBROUTINE branch_finish
+
+END MODULE glomap_branch_mod
