diff --color -ruN a/src/box/glomap_dump_mod.F90 b/src/box/glomap_dump_mod.F90
--- a/src/box/glomap_dump_mod.F90	1969-12-31 16:00:00
+++ b/src/box/glomap_dump_mod.F90	2026-08-13 18:52:00
@@ -0,0 +1,98 @@
+! *****************************COPYRIGHT*******************************
+! (c) 2026. Validation instrumentation for the GLOMAP-JAX port.
+! New code, BSD 3-Clause (see LICENCE). Not part of UKCA.
+! *****************************COPYRIGHT*******************************
+!
+! Description:
+!   Per-process state snapshots, for validating the JAX port routine by routine.
+!
+!   ukca_aero_step calls thirteen process routines per chemistry step. Comparing
+!   only the end state tells you THAT a port diverged; comparing after each call
+!   tells you WHERE. Budgets (bud_aer_mas) carry mass fluxes only -- no number
+!   concentration, no diameters -- so they cannot localise the failures that
+!   actually happen in coagulation and mode merging.
+!
+!   This module deliberately has NO `USE` statements. It is compiled into
+!   src/box but called from src/ukca, and a dependency in that direction would
+!   create a USE cycle with the box modules that already depend on UKCA. Taking
+!   plain arrays keeps the dependency graph acyclic.
+!
+!   Writes one record per call: a text tag, the (imts, izts) substep counters,
+!   and the state at full double precision.
+!
+MODULE glomap_dump_mod
+
+IMPLICIT NONE
+PRIVATE
+
+INTEGER, SAVE :: dump_unit = -1
+LOGICAL, SAVE :: dump_open = .FALSE.
+INTEGER, SAVE :: dump_step = 0
+
+PUBLIC :: dump_start, dump_set_step, dump_state, dump_finish
+
+CONTAINS
+
+SUBROUTINE dump_start(filename)
+IMPLICIT NONE
+CHARACTER(LEN=*), INTENT(IN) :: filename
+IF (LEN_TRIM(filename) == 0) RETURN
+OPEN(NEWUNIT=dump_unit, FILE=filename, STATUS='REPLACE', ACTION='WRITE')
+! OPEN(NEWUNIT=) returns a NEGATIVE unit, so openness is tracked explicitly
+! rather than by the sign of the unit number.
+dump_open = .TRUE.
+WRITE(dump_unit,'(A)') 'step,site,imts,izts,field,imode,icp,value'
+END SUBROUTINE dump_start
+
+SUBROUTINE dump_set_step(istep)
+IMPLICIT NONE
+INTEGER, INTENT(IN) :: istep
+dump_step = istep
+END SUBROUTINE dump_set_step
+
+SUBROUTINE dump_state(site, imts, izts, nbox, nmodes, ncp, nd, mdt, md, drydp,  &
+                      wetdp, mdwat, rhopar)
+! Long-format records: one line per (field, mode, component). Verbose, but it
+! makes a diff trivially attributable to a single array element, which is the
+! entire point of the exercise.
+IMPLICIT NONE
+CHARACTER(LEN=*), INTENT(IN) :: site
+INTEGER, INTENT(IN) :: imts, izts, nbox, nmodes, ncp
+REAL,    INTENT(IN) :: nd(nbox,nmodes), mdt(nbox,nmodes)
+REAL,    INTENT(IN) :: md(nbox,nmodes,ncp)
+REAL,    INTENT(IN) :: drydp(nbox,nmodes), wetdp(nbox,nmodes)
+REAL,    INTENT(IN) :: mdwat(nbox,nmodes), rhopar(nbox,nmodes)
+INTEGER :: imode, icp
+
+IF (.NOT. dump_open) RETURN
+
+DO imode = 1, nmodes
+  CALL emit(site, imts, izts, 'nd',     imode, 0, nd(1,imode))
+  CALL emit(site, imts, izts, 'mdt',    imode, 0, mdt(1,imode))
+  CALL emit(site, imts, izts, 'drydp',  imode, 0, drydp(1,imode))
+  CALL emit(site, imts, izts, 'wetdp',  imode, 0, wetdp(1,imode))
+  CALL emit(site, imts, izts, 'mdwat',  imode, 0, mdwat(1,imode))
+  CALL emit(site, imts, izts, 'rhopar', imode, 0, rhopar(1,imode))
+  DO icp = 1, ncp
+    CALL emit(site, imts, izts, 'md', imode, icp, md(1,imode,icp))
+  END DO
+END DO
+
+END SUBROUTINE dump_state
+
+SUBROUTINE emit(site, imts, izts, field, imode, icp, value)
+IMPLICIT NONE
+CHARACTER(LEN=*), INTENT(IN) :: site, field
+INTEGER, INTENT(IN) :: imts, izts, imode, icp
+REAL,    INTENT(IN) :: value
+WRITE(dump_unit,'(I0,",",A,",",I0,",",I0,",",A,",",I0,",",I0,",",ES24.16)')     &
+  dump_step, TRIM(site), imts, izts, TRIM(field), imode, icp, value
+END SUBROUTINE emit
+
+SUBROUTINE dump_finish()
+IMPLICIT NONE
+IF (dump_open) CLOSE(dump_unit)
+dump_open = .FALSE.
+END SUBROUTINE dump_finish
+
+END MODULE glomap_dump_mod
