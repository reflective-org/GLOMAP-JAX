! ---------------------------------------------------------------------------
! Clean marine case using the 5-mode SU/SS/BC/OC configuration, which adds
! an insoluble Aitken mode and therefore exercises ageing and the
! soluble/insoluble coagulation pathways.
! ---------------------------------------------------------------------------
&box_run
  run_name     = 'marine_bcoc'
  nsteps       = 48
  dt_chem      = 1800.0
  nmts         = 1
  nzts         = 15
  output_every = 1
  output_file  = 'out/marine_bcoc.csv'
  verbose      = 0
/

&box_env
  temperature = 283.0
  pressure    = 1.0e5
  rel_humid   = 0.80
  height      = 100.0
  pbl_height  = 800.0
/

&box_aerosol
  i_mode_setup = 2
  !          nucsol   aitsol   accsol   corsol   aitins  accins corins supins
  nd_init  =    0.0,   300.0,    80.0,     3.0,   200.0,   0.0,   0.0,   0.0
  dp_init  =   -1.0, 40.0e-9, 200.0e-9, 1.5e-6, 30.0e-9,  -1.0,  -1.0,  -1.0
/

&box_gas
  h2so4_init   = 2.0e6
  h2so4_prod   = 2.0e4
  sec_org_init = 1.0e6
  sec_org_prod = 1.0e5
/

&box_process
  cond_on      = 1
  nucl_on      = 1
  coag_on      = 1
  bln_on       = 0
  i_nuc_method = 2
  icoag        = 1
  imerge       = 1
/
