! ---------------------------------------------------------------------------
! Cold, clean free troposphere: low condensation sink and low temperature, so
! binary homogeneous nucleation produces a strong new-particle burst which
! then decays by self-coagulation.
! ---------------------------------------------------------------------------
&box_run
  run_name     = 'free_troposphere'
  nsteps       = 48
  dt_chem      = 1800.0
  nmts         = 1
  nzts         = 15
  output_every = 1
  output_file  = 'out/free_troposphere.csv'
  verbose      = 0
/

&box_env
  temperature = 235.0
  pressure    = 2.0e4
  rel_humid   = 0.90
  spec_humid  = -1.0
  height      = 10000.0
  pbl_height  = 1000.0
  box_volume  = 1.0
/

&box_aerosol
  i_mode_setup = 1
  nd_init  =    0.0,    20.0,     2.0,    0.01,   0.0,   0.0,   0.0,   0.0
  dp_init  =   -1.0,  40.0e-9, 200.0e-9, 2.0e-6, -1.0,  -1.0,  -1.0,  -1.0
/

&box_gas
  h2so4_init   = 1.0e6
  h2so4_prod   = 5.0e4
  sec_org_init = 0.0
  sec_org_prod = 0.0
/

&box_process
  cond_on      = 1
  nucl_on      = 1
  coag_on      = 1
  bln_on       = 0
  i_nuc_method = 2
  icoag        = 1
  imerge       = 1
  ifuchs       = 1
  idcmfp       = 1
  icondiam     = 1
/
