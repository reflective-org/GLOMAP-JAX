! Template: @MS@ is substituted with the i_mode_setup value by run_tests.sh.
! Populates every mode index so each configuration exercises whichever of
! them it actually activates.
&box_run
  run_name='mode_setup_@MS@'  nsteps=12  dt_chem=1800.0  nzts=15
  output_every=4  output_file='out/ms_@MS@.csv'
/
&box_env
  temperature=283.0  pressure=1.0e5  rel_humid=0.70  height=500.0  pbl_height=1000.0
/
&box_aerosol
  i_mode_setup = @MS@
  !          nucsol   aitsol    accsol   corsol   aitins    accins   corins  supins
  nd_init  =    0.0,   500.0,     80.0,     2.0,   100.0,     10.0,     1.0,    0.1
  dp_init  =   -1.0, 40.0e-9, 200.0e-9,  2.0e-6, 30.0e-9, 300.0e-9,  2.0e-6, 5.0e-6
/
&box_gas
  h2so4_init=3.0e6  h2so4_prod=3.0e4  sec_org_init=1.0e6  sec_org_prod=5.0e4
/
&box_process
  cond_on=1  nucl_on=1  coag_on=1  i_nuc_method=2  icoag=1  imerge=1
/
